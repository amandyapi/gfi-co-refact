                            </div>

                            <div class="form-group col-sm-6">
                                <label for="projectType">Type de projet *</label>
                                <select id="projectType" name="projectType" required>
                                    <option value="">Choisir...</option>
                                    <option value="Villa plain-pied">Villa plain-pied</option>
                                    <option value="Villa duplex (R+1)">Villa duplex (R+1)</option>
                                    <option value="Immeuble résidentiel">Immeuble résidentiel</option>
                                    <option value="Rénovation / Second œuvre">Rénovation / Second œuvre</option>
                                    <option value="Bureau / Local commercial">Bureau / Local commercial</option>
