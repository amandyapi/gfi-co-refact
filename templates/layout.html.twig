                                    <option value="400 – 600 m²">400 – 600 m²</option>
                                    <option value="600 – 1 000 m²">600 – 1 000 m²</option>
                                    <option value="1 000 – 2 500 m²">1 000 – 2 500 m²</option>
                                    <option value="Plus de 2 500 m²">Plus de 2 500 m²</option>
                                    <option value="Je n'ai pas encore de terrain">Je n'ai pas encore de terrain</option>
                                </select>
                            </div>
                            
                            <div class="form-group col-sm-6">
                                <label for="budget">Budget estimé (FCFA) *</label>
                                <select id="budget" name="budget" required>
                                    <option value="">Choisir...</option>
                                    <option value="Moins de 30 millions">Moins de 30 millions</option>
                                    <option value="30 à 60 millions">30 à 60 millions</option>
                                    <option value="60 à 100 millions">60 à 100 millions</option>
                                    <option value="100 à 200 millions">100 à 200 millions</option>
                                    <option value="Plus de 200 millions">Plus de 200 millions</option>
