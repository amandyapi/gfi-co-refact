                                    <option value="Villa duplex (R+1)">{% if current_locale == 'en' %}Duplex villa (R+1){% else %}Villa duplex (R+1){% endif %}</option>
                                    <option value="Immeuble résidentiel">{% if current_locale == 'en' %}Residential building{% else %}Immeuble résidentiel{% endif %}</option>
                                    <option value="Rénovation / Second œuvre">{% if current_locale == 'en' %}Renovation / Interior works{% else %}Rénovation / Second œuvre{% endif %}</option>
                                    <option value="Bureau / Local commercial">{% if current_locale == 'en' %}Office / Commercial space{% else %}Bureau / Local commercial{% endif %}</option>
                                    <option value="Programme immobilier">{% if current_locale == 'en' %}Real estate program{% else %}Programme immobilier{% endif %}</option>
                                    <option value="Autre">{% if current_locale == 'en' %}Other{% else %}Autre{% endif %}</option>
                                </select>
                            </div>
                            
                            <div class="form-group col-sm-6">
                                <label for="landSize">
                                    {% if current_locale == 'en' %}Land area (m²) *{% else %}Superficie du terrain (m²) *{% endif %}
