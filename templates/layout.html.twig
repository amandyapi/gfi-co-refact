                                    <option value="60 à 100 millions">60 – 100 million</option>
                                    <option value="100 à 200 millions">100 – 200 million</option>
                                    <option value="Plus de 200 millions">{% if current_locale == 'en' %}More than 200 million{% else %}Plus de 200 millions{% endif %}</option>
                                    <option value="Je ne sais pas encore">{% if current_locale == 'en' %}I don't know yet{% else %}Je ne sais pas encore{% endif %}</option>
