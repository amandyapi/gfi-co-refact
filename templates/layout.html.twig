                                                </a>
                                            </li>
                                            <li class="rd-nav-item {{ app.request.attributes.get('_route') == 'app_about' ? 'active' : '' }}">
                                                <a class="rd-nav-link" href="{{ path('app_about', {_locale: current_locale}) }}">
