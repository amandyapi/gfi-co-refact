                                                        {% if current_locale == 'en' %}GFI-CO Construction{% else %}GFI-CO Construction{% endif %}
                                                    </a></li>
                                                    <li class="rd-dropdown-item"><a class="rd-dropdown-link" href="{{ path('app_branches_design', {_locale: current_locale}) }}">
