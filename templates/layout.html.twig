                    <br>
                    <form id="quoteForm" onsubmit="submitForm(event)">
                        <div class="row">
                            <div class="form-group col-sm-6">
                                <label for="fullName">Prénom &amp; Nom *</label>
                                <input type="text" id="fullName" name="fullName" required placeholder="Votre prénom et nom">
                            </div>
                            
                            <div class="form-group col-sm-6">
