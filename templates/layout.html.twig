        <script>
            // Gestion de l'autoplay par slide
            document.addEventListener('DOMContentLoaded', function() {
                var swiperContainer = document.querySelector('.swiper-slider-business');
                if (swiperContainer) {
                    setTimeout(function() {
                        var swiper = swiperContainer.swiper;
                        if (swiper) {
                            var slides = swiperContainer.querySelectorAll('.swiper-slide');
                            var autoplayDurations = {};
                            
                            slides.forEach(function(slide, index) {
                                var duration = slide.getAttribute('data-autoplay');
                                if (duration) {
                                    autoplayDurations[index] = parseInt(duration, 10);
                                }
                            });
                            
                            swiper.on('slideChange', function() {
                                var activeIndex = this.realIndex;
                                var duration = autoplayDurations[activeIndex];
                                if (duration) {
                                    this.params.autoplay.delay = duration;
                                    this.autoplay.stop();
                                    this.autoplay.start();
                                } else {
                                    this.params.autoplay.delay = 5000;
                                    this.autoplay.stop();
                                    this.autoplay.start();
                                }
                            });
                        }
                    }, 500);
                }
            });
        </script>

        <script>
            // Ouvrir la modale
            function openQuoteModal() {
                document.querySelector('.page-header').classList.add('modal-open');
                document.getElementById('quoteModal').classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            // Fermer la modale
            function closeQuoteModal() {
                document.querySelector('.page-header').classList.remove('modal-open');
                document.getElementById('quoteModal').classList.remove('active');
                document.body.style.overflow = 'auto';
            }

            // Fermer en cliquant à l'extérieur
            document.getElementById('quoteModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closeQuoteModal();
                }
            });

            // Soumission du formulaire
            function submitForm(event) {
                event.preventDefault();
                
                const formData = {
                    fullName: document.getElementById('fullName').value,
                    phone: document.getElementById('phone').value,
                    projectType: document.getElementById('projectType').value,
                    landSize: document.getElementById('landSize').value,
                    budget: document.getElementById('budget').value,
                    finishLevel: document.getElementById('finishLevel').value,
                    message: document.getElementById('message').value
                };
                
                // Envoyer via fetch
                fetch('{{ path('app_quote_submit') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(formData)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ {% if current_locale == 'en' %}Your request has been sent successfully! We will contact you within 48 hours.{% else %}Votre demande a été envoyée avec succès ! Nous vous contacterons sous 48h.{% endif %}');
                        closeQuoteModal();
                        document.getElementById('quoteForm').reset();
                    } else {
                        alert('❌ {% if current_locale == 'en' %}An error occurred. Please try again.{% else %}Une erreur est survenue. Veuillez réessayer.{% endif %}');
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    alert('❌ {% if current_locale == 'en' %}An error occurred. Please try again.{% else %}Une erreur est survenue. Veuillez réessayer.{% endif %}');
                });
            }
        </script>
        
        {% block javascripts %}{% endblock %}
    </body>
</html>