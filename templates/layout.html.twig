                                    <option value="200 – 400 m²">200 – 400 m²</option>
                                    <option value="400 – 600 m²">400 – 600 m²</option>
                                    <option value="600 – 1 000 m²">600 – 1 000 m²</option>
                                    <option value="1 000 – 2 500 m²">1 000 – 2 500 m²</option>
                                    <option value="Plus de 2 500 m²">{% if current_locale == 'en' %}More than 2,500 m²{% else %}Plus de 2 500 m²{% endif %}</option>
                                    <option value="Je n'ai pas encore de terrain">{% if current_locale == 'en' %}I don't have land yet{% else %}Je n'ai pas encore de terrain{% endif %}</option>
                                </select>
                            </div>
                            
