                                       placeholder="{% if current_locale == 'en' %}Your first and last name{% else %}Votre prénom et nom{% endif %}">
                            </div>
                            
                            <div class="form-group col-sm-6">
                                <label for="phone">
                                    {% if current_locale == 'en' %}Phone / WhatsApp *{% else %}Téléphone / WhatsApp *{% endif %}
                                </label>
                                <input type="tel" id="phone" name="phone" required 
                                       placeholder="{% if current_locale == 'en' %}Your phone number{% else %}Votre numéro de téléphone{% endif %}">
                            </div>

                            <div class="form-group col-sm-6">
                                <label for="projectType">
                                    {% if current_locale == 'en' %}Project type *{% else %}Type de projet *{% endif %}
