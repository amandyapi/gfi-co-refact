<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <title>Confirmation de réception</title>
</head>
<body style="font-family: Arial, sans-serif; color: #333; line-height: 1.6;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #eee; border-radius: 8px;">
        <h2 style="color: #fdb900; border-bottom: 2px solid #fdb900; padding-bottom: 10px;">
            {% if locale == 'en' %}Thank you for your message{% else %}Merci pour votre message{% endif %}
        </h2>

        <p>
            {% if locale == 'en' %}
                Dear {{ data.firstname }} {{ data.lastname }},
            {% else %}
                Bonjour {{ data.firstname }} {{ data.lastname }},
            {% endif %}
        </p>

        <p>
            {% if locale == 'en' %}
                We have received your message and will get back to you within 48 hours.
            {% else %}
                Nous avons bien reçu votre message et vous répondrons dans les 48 heures.
            {% endif %}
        </p>

        <p>
            {% if locale == 'en' %}
                Here is a copy of your message:
            {% else %}
                Voici une copie de votre message :
            {% endif %}
        </p>

        <div style="background: #f9f9f9; padding: 15px; border-radius: 6px; white-space: pre-wrap;">{{ data.message }}</div>

        <p style="margin-top: 30px;">
            {% if locale == 'en' %}
                Best regards,<br>
            {% else %}
                Cordialement,<br>
            {% endif %}
            <strong>GFI-CO GROUP</strong>
        </p>

        <p style="font-size: 12px; color: #999; margin-top: 30px; border-top: 1px solid #eee; padding-top: 15px;">
            GFI-CO GROUP - LT 18 IL 1 AKOUEDO TRIANGLE, Quartier 09 Secteur Palmeraie, Abidjan, Côte d'Ivoire<br>
            (+225) 01 43 100 250 / (+225) 07 58 835 008<br>
            contact@gfi-co.net
        </p>
    </div>
</body>
</html>