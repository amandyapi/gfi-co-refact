{# templates/bundles/TwigBundle/Exception/error.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Erreur{% endblock %}

{% block bread_subtitle %}Erreur{% endblock %}
{% block bread_title %}Une erreur est survenue{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_home', {_locale: app.request.locale|default('fr')}) }}">Accueil</a></li>
    <li class="active">Erreur</li>
{% endblock %}

{% block page %}
    <section class="section section-single bg-gray-800 bg-overlay-1" style="background-image: url({{ asset('assets/images/bg-image-3.jpg') }});">
        <div class="section-single-inner">
            <div class="section-single-dummy"></div>
            <div class="section-single-main">
                <div class="container"> 
                    <div class="row row-30">
                        <div class="col-sm-6 text-center text-sm-start">
                            <p class="text-extra-large">{{ status_code }}</p>
                        </div>
                        <div class="col-sm-6">
                            <div class="section-single-main-content">
                                <h6 class="title-decorated title-decorated-lg">
                                    {% if app.request.locale|default('fr') == 'en' %}
                                        An error occurred
                                    {% else %}
                                        Une erreur est survenue
                                    {% endif %}
                                </h6>
                                <p>
                                    {% if app.request.locale|default('fr') == 'en' %}
                                        Sorry, an error occurred while processing your request.<br>
                                        Please return to our homepage.
                                    {% else %}
                                        Désolé, une erreur est survenue lors du traitement de votre demande.<br>
                                        Veuillez retourner sur notre page d'accueil.
                                    {% endif %}
                                </p>
                                <a class="button button-lg button-primary button-winona" href="{{ path('app_home', {_locale: app.request.locale|default('fr')}) }}">
                                    {% if app.request.locale|default('fr') == 'en' %}
                                        Back to home page
                                    {% else %}
                                        Retour à l'accueil
                                    {% endif %}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}