{# templates/pages/contact.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Contactez-nous - Devis et informations{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

    <style>
        #contact-map {
            width: 100%;
            /*height: 600px;*/
            min-height: 600px;
        }

        .leaflet-container {
            z-index: 1;
        }
    </style>
{% endblock %}

{% block description %}Contactez GFI-CO GROUP pour vos projets immobiliers en Côte d'Ivoire et en Guinée. Demandez un devis, des informations ou prenez rendez-vous.{% endblock %}

{% block bread_subtitle %}Nous contacter{% endblock %}
{% block bread_title %}Contactez-nous{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_contact') }}">Contact</a></li>
    <li class="active">Nous écrire</li>
{% endblock %}

{% block page %}
    <!-- Coordonnées -->
    <section class="section section-sm">
        <div class="container">
            <div class="layout-bordered">
                <div class="layout-bordered-item wow-outer">
                    <div class="layout-bordered-item-inner wow slideInUp">
                        <div class="icon icon-lg mdi mdi-phone text-primary"></div>
                        <ul class="list-0">
                            <li><a class="link-default" href="tel:+2250143100250">(+225) 07 58 835 008 /</a></li>
                            <li><a class="link-default" href="tel:+2250143100250">(+225) 01 431 00 250</a></li>
                        </ul>
                    </div>
                </div>
                <div class="layout-bordered-item wow-outer">
                    <div class="layout-bordered-item-inner wow slideInUp">
                        <div class="icon icon-lg mdi mdi-email text-primary"></div>
                        <a class="link-default" href="mailto:contact@gfi-co.net">contact@gfi-co.net</a>
                    </div>
                </div>
                <div class="layout-bordered-item wow-outer">
                    <div class="layout-bordered-item-inner wow slideInUp">
                        <div class="icon icon-lg mdi mdi-map-marker text-primary"></div>
                        <a class="link-default" href="#">LT 18 IL 1 AKOUEDO TRIANGLE, Quartier 09 Secteur Palmeraie, Abidjan, Côte d'Ivoire</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulaire de contact + Carte -->
    <section class="section bg-gray-100">
        <div class="range justify-content-xl-between">
            <div class="cell-xl-6 align-self-center container">
                <div class="row">
                    <div class="col-lg-9 cell-inner">
                        <div class="section-lg">
                            <h3 class="wow-outer">
                                <span class="wow slideInDown">Nous contacter</span>
                            </h3>

                            <!-- Flash Messages -->
                            {% for type, messages in app.flashes %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert" style="margin: 20px auto; max-width: 900px;">
                                        {% if type == 'success' %}
                                            <i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i>
                                        {% elseif type == 'error' or type == 'danger' %}
                                            <i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>
                                        {% elseif type == 'warning' %}
                                            <i class="fa-solid fa-triangle-exclamation" style="margin-right: 8px;"></i>
                                        {% else %}
                                            <i class="fa-solid fa-circle-info" style="margin-right: 8px;"></i>
                                        {% endif %}
                                        {{ message }}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float: right; background: none; border: none; font-size: 18px; cursor: pointer;">&times;</button>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                            
                            <!-- RD Mailform -->
                            <form class="rd-form rd-mailform" data-form-output="form-output-global" data-form-type="contact" method="post" action="{{ path('app_contact_submit') }}">
                                <div class="row row-10">
                                    <div class="col-md-6 wow-outer">
                                        <div class="form-wrap wow fadeSlideInUp">
                                            <label class="form-label-outside" for="contact-first-name">Prénoms</label>
                                            <input class="form-input" id="contact-first-name" type="text" name="firstname" data-constraints="@Required">
                                        </div>
                                    </div>
                                    <div class="col-md-6 wow-outer">
                                        <div class="form-wrap wow fadeSlideInUp">
                                            <label class="form-label-outside" for="contact-last-name">Nom</label>
                                            <input class="form-input" id="contact-last-name" type="text" name="lastname" data-constraints="@Required">
                                        </div>
                                    </div>
                                    <div class="col-md-6 wow-outer">
                                        <div class="form-wrap wow fadeSlideInUp">
                                            <label class="form-label-outside" for="contact-email">E-mail</label>
                                            <input class="form-input" id="contact-email" type="email" name="email" data-constraints="@Email @Required">
                                        </div>
                                    </div>
                                    <div class="col-md-6 wow-outer">
                                        <div class="form-wrap wow fadeSlideInUp">
                                            <label class="form-label-outside" for="contact-phone">Téléphone</label>
                                            <input class="form-input" id="contact-phone" type="text" name="phone" data-constraints="@PhoneNumber">
                                        </div>
                                    </div>
                                    <div class="col-12 wow-outer">
                                        <div class="form-wrap wow fadeSlideInUp">
                                            <label class="form-label-outside" for="contact-message">Votre Message</label>
                                            <textarea class="form-input" id="contact-message" name="message" data-constraints="@Required"></textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="group group-middle">
                                    <div class="wow-outer">
                                        <button class="button button-primary button-winona wow slideInRight" type="submit">Envoyer</button>
                                    </div>
                                    <p>ou utilisez</p>
                                    <div class="wow-outer">
                                        <a 
                                            id="whatsapp-link"
                                            class="button button-primary-outline button-icon button-icon-left button-winona wow slideInLeft" 
                                            target="__blank" 
                                            rel="noopener noreferrer"
                                            href="#">
                                            <span class="icon mdi mdi-whatsapp"></span>Whatsapp
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cell-xl-5 height-fill wow fadeIn">
                <section class="section">
                    <div id="contact-map"></div>
                </section>
            </div>
        </div>
    </section>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const mapContainer = document.getElementById('contact-map');

        if (!mapContainer) {
            console.error('Container contact-map introuvable');
            return;
        }
        const latitude = 5.3809;
        const longitude = -3.9437;
        const map = L.map('contact-map').setView(
            [latitude, longitude],
            16
        );
        L.tileLayer(
            'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
            {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap Contributors'
            }
        ).addTo(map);

        L.marker([latitude, longitude])
            .addTo(map)
            .bindPopup(`
                <strong>GFI-CO GROUP</strong><br>
                LT 18 IL 1 AKOUEDO TRIANGLE<br>
                Quartier 09 Secteur Palmeraie<br>
                Abidjan, Côte d'Ivoire
            `)
            .openPopup();
        // utile quand la carte est dans une colonne ou un layout responsive
        setTimeout(() => {
            map.invalidateSize();
        }, 200);
    });
</script>
<script>
    document.getElementById('whatsapp-link').addEventListener('click', function (e) {
        e.preventDefault();

        const firstname = document.querySelector('[name="firstname"]').value.trim();
        const lastname  = document.querySelector('[name="lastname"]').value.trim();
        const email     = document.querySelector('[name="email"]').value.trim();
        const phone     = document.querySelector('[name="phone"]').value.trim();
        const message   = document.querySelector('[name="message"]').value.trim();

        const whatsappMessage = `
     *Nouveau message du formulaire de contact*

    \`\`\`
    *Prénoms*   : ${firstname}
    *Nom*       : ${lastname}
    *Email*     : ${email}
    *Téléphone* : ${phone || 'Non renseigné'}
    \`\`\`

     *Message*

    ${message}
    `.trim();

        const whatsappNumber = '2250758835008';

        const whatsappUrl =
            `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

        window.open(whatsappUrl, '_blank');
    });
</script>
{% endblock %}