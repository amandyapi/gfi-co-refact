{# templates/pages/projets/conception/villa-the-pearl-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | The Pearl - Sustainable single-storey villa{% endblock %}

{% block description %}Discover The Pearl, the signature single-storey villa of the Pearl City program. Eco-construction, energy autonomy and contemporary design by GFI-CO.{% endblock %}

{% block bread_subtitle %}Design and project planning{% endblock %}
{% block bread_title %}The Pearl — The single-storey villa reinventing the art of sustainable living{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_conception', {_locale: 'en'}) }}">Design and project planning</a></li>
    <li class="active">The Pearl</li>
{% endblock %}

{% block page %}
    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse align-items-stretch">
                
                <!-- Text column -->
                <div class="col-md-10 col-lg-6 col-xl-6 d-flex">
                    <div class="inset-left-2 d-flex flex-column justify-content-center">
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Residential project · Pearl City Program</h5>
                        <p style="text-align: justify;">Anchored to the ground, The Pearl embodies a new way of living: single-storey, with no compromise on style or environmental performance. This signature villa of the THE PEARL CITY program is aimed at those seeking the simplicity of a home accessible at every stage of life, without ever giving up architectural standards.</p>
                        <p style="text-align: justify;">Designed according to the principles of new-generation eco-construction, The Pearl uses sustainable materials: compressed earth bricks and green concrete combined with solar panels and smart water and waste management systems. Energy autonomy designed to reduce the environmental footprint while guaranteeing comfort and resilience in everyday life.</p>
                        <p style="text-align: justify; font-weight: 500;">With The Pearl, GFI-CO gives shape to its ambition for tomorrow's cities: healthy, harmonious and responsible housing.</p>
                    </div>
                </div>

                <!-- Video column -->
                <div class="col-md-10 col-lg-6 d-flex align-items-center">
                    <div class="thumbnail-video-1 bg-gray-700 w-100">
                        <div class="ratio ratio-16x9">
                            <video controls>
                                <source src="{{ asset('assets/videos/projets/1-conception/the-pearl/1.mp4') }}" type="video/mp4">
                                Your browser does not support video playback.
                            </video>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..8 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/1-conception/the-pearl/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Do you have a similar project? <span class="fw-bold" style="color:#fff;">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}" style="border-color:#fff; color:#fff;">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}