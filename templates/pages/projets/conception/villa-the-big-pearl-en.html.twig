{# templates/pages/projets/conception/villa-the-big-pearl-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | The Big Pearl - Sustainable R+1 duplex{% endblock %}

{% block description %}Discover The Big Pearl, the R+1 duplex of the Pearl City program. Space, comfort and eco-design by GFI-CO.{% endblock %}

{% block bread_subtitle %}Design and project planning{% endblock %}
{% block bread_title %}The Big Pearl — The R+1 duplex that gives space to your ambitions{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_conception', {_locale: 'en'}) }}">Design and project planning</a></li>
    <li class="active">The Big Pearl</li>
{% endblock %}

{% block page %}
    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Residential project · Pearl City Program</h5>
                        <p style="text-align: justify;">Over two levels, The Big Pearl unfolds the full potential of the THE PEARL CITY program for families seeking space, ceiling height and perspective. Its R+1 architecture frees up generous volumes and enhanced privacy between living areas and bedrooms, without ever departing from the eco-design that is the program's signature.</p>
                        <p style="text-align: justify;">Like the entire city, The Big Pearl relies on sustainable materials: compressed earth bricks, green concrete, solar panels and smart water and waste management, for a residence that is energy self-sufficient and resilient to climate challenges.</p>
                        <p style="text-align: justify; font-weight: 500;">The Big Pearl embodies GFI-CO's ambition for housing where environmental performance and quality of life become one.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <div class="thumbnail-video-1 bg-gray-700">
                        <div class="ratio ratio-16x9">
                            <video width="570" height="320" controls>
                                <source src="{{ asset('assets/videos/projets/1-conception/the-big-pearl/2.mp4') }}" type="video/mp4">
                                Your browser does not support video playback.
                            </video>
                        </div>
                        <div class="thumbnail-video__overlay video-overlay" style="background-image: url({{ asset('assets/images/projets/1-conception/the-big-pearl/1.jpg') }})">
                            <div class="button-video"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..8 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/1-conception/the-big-pearl/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Do you have a similar project? <span class="fw-bold" style="color:#fff;">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}" style="border-color:#fff; color:#fff;">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}