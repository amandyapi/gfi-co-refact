{# templates/pages/projets/conception/villa-the-big-pearl-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | The Big Pearl - Duplex R+1 durable{% endblock %}

{% block description %}Découvrez The Big Pearl, duplex R+1 du programme Pearl City. Espace, confort et écoconception par GFI-CO.{% endblock %}

{% block bread_subtitle %}Conception plans et projets{% endblock %}
{% block bread_title %}The Big Pearl — Le duplex R+1 qui offre de l'espace à vos ambitions{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_conception', {_locale: 'fr'}) }}">Conception plans et projets</a></li>
    <li class="active">The Big Pearl</li>
{% endblock %}

{% block page %}
    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Projet résidentiel · Programme Pearl City</h5>
                        <p style="text-align: justify;">Sur deux niveaux, The Big Pearl déploie tout le potentiel du programme THE PEARL CITY pour les familles en quête d'espace, de hauteur sous plafond et de perspective. Son architecture R+1 libère des volumes généreux et une intimité renforcée entre les espaces de vie et les chambres, sans jamais s'éloigner de l'écoconception qui fait la signature du programme.</p>
                        <p style="text-align: justify;">Comme l'ensemble de la cité, The Big Pearl s'appuie sur des matériaux durables : briques de terre compressée, béton vert, des panneaux solaires et une gestion intelligente de l'eau et des déchets, pour une résidence autosuffisante en énergie et résiliente face aux enjeux climatiques.</p>
                        <p style="text-align: justify; font-weight: 500;">The Big Pearl, c'est l'ambition de GFI-CO pour un habitat où performance environnementale et qualité de vie ne font plus qu'un.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <div class="thumbnail-video-1 bg-gray-700">
                        <div class="ratio ratio-16x9">
                            <video width="570" height="320" controls>
                                <source src="{{ asset('assets/videos/projets/1-conception/the-big-pearl/2.mp4') }}" type="video/mp4">
                                Votre navigateur ne supporte pas la lecture de vidéos.
                            </video>
                        </div>
                        <div class="thumbnail-video__overlay video-overlay" style="background-image: url({{ asset('assets/images/projets/1-conception/the-big-pearl/1.jpg') }})">
                            <div class="button-video"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..8 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/1-conception/the-big-pearl/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}