{# templates/pages/projets/conception/villa-duplex-r1-bingerville-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Duplex Villa R+1 in Bingerville - 500 m² of excellence{% endblock %}

{% block description %}Discover the design project of a premium R+1 duplex villa in Bingerville: 8 rooms over 500 m² of land. APS and DQE studies by GFI-CO.{% endblock %}

{% block bread_subtitle %}Design and project planning{% endblock %}
{% block bread_title %}Duplex Villa R+1 in Bingerville - 500 m² of architectural excellence{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_conception', {_locale: 'en'}) }}">Design and project planning</a></li>
    <li class="active">Duplex Villa R+1 in Bingerville</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Individual</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Location</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Bingerville, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature of works</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Construction project of an 8-room premium duplex villa</a></li>
                        <li><a href="#">500 m² plot</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Services</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Architectural plan development</a></li>
                        <li><a href="#">Preliminary Design study (APS)</a></li>
                        <li><a href="#">DQE (Detailed Estimated Bill of Quantities)</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Studies & design · Bingerville · 8 rooms · 500 m²</h5>
                        <p style="text-align: justify;">Eight rooms, 500 m² of land, one ambition: to design a duplex residence meeting international standards. For this premium project in Bingerville, GFI-CO's teams carried out a complete study, from the Preliminary Design (APS) to the Detailed Estimated Bill of Quantities (DQE), to precisely define volumes, materials and budget.</p>
                        <p style="text-align: justify;">This methodological rigour is GFI-CO's hallmark: every plan is designed to anticipate costs, secure deadlines and guarantee a result faithful to the client's vision, even before the first spade hits the ground.</p>
                        <p style="text-align: justify; font-weight: 500;">A project that demonstrates GFI-CO's expertise in designing high-end duplex villas and mastering technical studies.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <div class="thumbnail-video-1 bg-gray-700">
                        <div class="ratio ratio-16x9">
                            <video width="570" height="320" controls>
                                <source src="{{ asset('assets/videos/projets/1-conception/duplex-r+1-bingerville/3.mp4') }}" type="video/mp4">
                                Your browser does not support video playback.
                            </video>
                        </div>
                        <div class="thumbnail-video__overlay video-overlay" style="background-image: url({{ asset('assets/images/projets/1-conception/the-pearl/1.jpg') }})">
                            <div class="button-video"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..8 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/1-conception/duplex-r+1-bingerville/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Do you have a similar project? <span class="fw-bold" style="color:#fff;">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}" style="border-color:#fff; color:#fff;">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}