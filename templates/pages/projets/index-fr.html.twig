{# templates/pages/projets/index-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Nos projets et réalisations{% endblock %}

{% block description %}Découvrez les projets de GFI-CO GROUP : conception de plans, programmes immobiliers, construction, second œuvre et aménagements. Plus de 12 projets livrés en Côte d'Ivoire.{% endblock %}

{% block bread_subtitle %}Nos réalisations{% endblock %}
{% block bread_title %}Projets{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li class="active">Tous nos projets</li>
{% endblock %}

