            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <!-- PDF 1 -->
                    <div class="pdf-item">
                        <div class="pdf-info">
                            <i class="fa-solid fa-file-pdf pdf-icon"></i>
                            <div>
                                <div style="font-weight: 600;">Eco-Terra City project presentation</div>
                                <div class="pdf-size">PDF • 2.4 MB</div>
                            </div>
                        </div>
                        <a href="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/1.pdf') }}" class="pdf-download-btn" download>
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                    </div>
                    <!-- PDF 2 -->
                    <div class="pdf-item">
                        <div class="pdf-info">
                            <i class="fa-solid fa-file-pdf pdf-icon"></i>
