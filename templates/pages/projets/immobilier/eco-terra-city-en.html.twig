{# templates/pages/projets/immobilier/eco-terra-city-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Eco-Terra City - Sustainable real estate program{% endblock %}

{% block description %}Discover Eco-Terra City, an innovative real estate program in the Republic of Guinea. Villas built with stabilised compressed earth bricks for sustainable housing.{% endblock %}

{% block bread_subtitle %}Real estate program project{% endblock %}
{% block bread_title %}Eco-Terra City — Redefining housing in sub-Saharan Africa{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_immobilier', {_locale: 'en'}) }}">Real estate program</a></li>
    <li class="active">Eco-Terra City</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Description</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href=ction of 500 affordable housing units (F3, F4, and F5 types) intended for employees of a mining company in Conakry</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Location</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li>#Guinea</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li>#Trade Union</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Project Developer</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li>#GFI-CO</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Project Timeline</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#"sultation Phase: Organization of a meeting between the Trade Union Executive Board, the Mine’s General Management, and GFI-CO to analyze and define staff housing needs.</a></li>
                        <li><a href="#">2024 – Project Presentation cial presentation of the housing development program at the mining site by GFI-CO Guinea’s management, in the presence of the Trade Union Executive Board and the General Management.</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Work Completed</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li>#Architectural design and planning</a></li>
                        <li>#Preliminary Design Study (APS) and Bill of Quantities & Cost Estimate (DQE)</a></li>
                        <li>#Search for financial and technical partners</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Real estate program · Republic of Guinea</h5>
                        <p style="text-align: justify;">What if tomorrow's housing were built today, with compressed earth? That is the challenge of Eco-Terra City, an ambitious real estate program that aims to redefine housing standards in sub-Saharan Africa. Designed around mixed villas: single-storey F4 and duplex F4/F5, the project mainly uses stabilised compressed earth bricks (BTCS) to combine energy performance, contemporary aesthetics and respect for the environment.</p>
                        <p style="text-align: justify;">Led by GFI-CO, a licensed real estate developer and builder, Eco-Terra City reflects a strong conviction: creating built spaces that meet the current needs of populations while preserving resources for future generations.</p>
                        <p style="text-align: justify; font-weight: 500;">Location: Republic of Guinea — Discover the Eco-Terra City program.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/9.jpg') }}" alt="Eco-Terra City Project" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- PDF download section -->
    <section class="pdf-download-section">
        <div class="container">
            <div class="text-center">
                <h3>Download the project documents</h3>
