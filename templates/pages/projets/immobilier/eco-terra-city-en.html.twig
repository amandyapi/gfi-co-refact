                                <div style="font-weight: 600;">F3 single-storey villa plan</div>
                                <div class="pdf-size">PDF • 3.1 MB</div>
                            </div>
                        </div>
                        <a href="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/2.jpg') }}" class="pdf-download-btn" download>
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                    </div>
                    <!-- PDF 3 -->
                    <div class="pdf-item">
                        <div class="pdf-info">
                            <i class="fa-solid fa-file-pdf pdf-icon"></i>
                            <div>
                                <div style="font-weight: 600;">F4 single-storey villa plan</div>
                                <div class="pdf-size">PDF • 1.8 MB</div>
                            </div>
                        </div>
                        <a href="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/3.jpg') }}" class="pdf-download-btn" download>
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                    </div>
                    <!-- PDF 4 -->
                    <div class="pdf-item">
                        <div class="pdf-info">
                            <i class="fa-solid fa-file-pdf pdf-icon"></i>
                            <div>
                                <div style="font-weight: 600;">F4 duplex plan</div>
                                <div class="pdf-size">PDF • 1.8 MB</div>
                            </div>
                        </div>
                        <a href="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/4.jpg') }}" class="pdf-download-btn" download>
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                    </div>
                    <!-- PDF 5 -->
                    <div class="pdf-item">
                        <div class="pdf-info">
                            <i class="fa-solid fa-file-pdf pdf-icon"></i>
                            <div>
                                <div style="font-weight: 600;">F5 duplex plan</div>
                                <div class="pdf-size">PDF • 1.8 MB</div>
                            </div>
                        </div>
                        <a href="{{ asset('assets/images/projets/2-immobilier/eco-terra-city/5.jpg') }}" class="pdf-download-btn" download>
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                    </div>
                </div>
            </div>
        </div>
