{# templates/pages/projets/index-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Our projects and achievements{% endblock %}

{% block description %}Discover GFI-CO GROUP's projects: blueprint design, real estate programs, construction, finishing works and fit-outs. More than 12 projects delivered in Côte d'Ivoire.{% endblock %}

{% block bread_subtitle %}Our achievements{% endblock %}
{% block bread_title %}Projects{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li class="active">All our projects</li>
{% endblock %}

