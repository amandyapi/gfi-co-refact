{# templates/pages/projets/autres/villa-palmera-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Villas Palmera - Finishing works for 5 duplex villas{% endblock %}

{% block description %}Discover the Villas Palmera project: high-end finishes for 5 duplex villas in Grand-Bassam by GFI-CO. Drywall, coverings, joinery and custom kitchens.{% endblock %}

{% block bread_subtitle %}Finishing Works & Fit-outs{% endblock %}
{% block bread_title %}Villas Palmera — High-end finishes for 5 duplex villas in Grand-Bassam{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_autres', {_locale: 'en'}) }}">Finishing Works & Fit-outs</a></li>
    <li class="active">Villas Palmera</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">JC Architecture on behalf of SIDI IMMOBILIER</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Location</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Grand-Bassam, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature of works</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Drywall, wall and floor coverings</a></li>
                        <li><a href="#">Wood and aluminium joinery</a></li>
                        <li><a href="#">Making of custom-fitted kitchens</a></li>
                        <li><a href="#">Wardrobes and cupboards</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Scope</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Finishing works for 5 premium duplex villas (SIDI Immobilier program)</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Execution time</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">5 months</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>GFI-CO's role</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Execution company</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Finishing works · Grand-Bassam · 5 duplex villas</h5>
                        <p style="text-align: justify;">Mandated by the JC Architecture firm on behalf of SIDI Immobilier, GFI-CO carried out all the finishing works for 5 duplex villas of the Villas Palmera program, in Grand-Bassam.</p>
                        <p style="text-align: justify;">Drywall, wall and floor coverings, wood and aluminium joinery, custom-fitted kitchens, wardrobes and cupboards: each villa received high-end finishes, delivered on time and in line with the project owner's requirements.</p>
                        <p style="text-align: justify; font-weight: 500;">This project reflects GFI-CO's expertise on large-scale real estate programs, where the quality of finishes determines the satisfaction of the end client.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/villa-palmera/1.jpg') }}" alt="Villa Palmera Project" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/1.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/2.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/3.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/4.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/5.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/6.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/7.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/8.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/9.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Do you have a similar project? <span class="fw-bold" style="color:#fff;">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}" style="border-color:#fff; color:#fff;">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}