{# templates/pages/projets/autres/villa-palmera-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Villas Palmera - Second œuvre de 5 villas duplex{% endblock %}

{% block description %}Découvrez le projet Villas Palmera : finitions haut de gamme de 5 villas duplex à Grand-Bassam par GFI-CO. Placoplâtre, revêtements, menuiserie et cuisines sur mesure.{% endblock %}

{% block bread_subtitle %}Second Œuvre & Aménagements{% endblock %}
{% block bread_title %}Villas Palmera — Les finitions haut de gamme de 5 villas duplex à Grand-Bassam{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_autres', {_locale: 'fr'}) }}">Second Œuvre & Aménagements</a></li>
    <li class="active">Villas Palmera</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">JC Architecture P/C SIDI IMMOBILIER</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Localisation</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Grand-Bassam, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature des travaux</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Placoplâtre, revêtement mural et sol</a></li>
                        <li><a href="#">Menuiserie bois et aluminium</a></li>
                        <li><a href="#">Confection de cuisines équipées sur mesure</a></li>
                        <li><a href="#">Dressing et placards</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Scope</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Travaux de second œuvre pour 5 villas duplex premium (programme SIDI Immobilier)</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Durée d'exécution</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">5 mois</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Rôle de GFI-CO</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Entreprise d'exécution</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Second œuvre · Grand-Bassam · 5 villas duplex</h5>
                        <p style="text-align: justify;">Mandatée par le cabinet JC Architecture pour le compte de SIDI Immobilier, GFI-CO a réalisé l'ensemble des travaux de second œuvre de 5 villas duplex du programme Villas Palmera, à Grand-Bassam.</p>
                        <p style="text-align: justify;">Placoplâtre, revêtements muraux et de sol, menuiserie bois et aluminium, cuisines équipées sur mesure, dressings et placards : chaque villa a bénéficié de finitions haut de gamme, livrées dans le respect des délais et des exigences du maître d'ouvrage.</p>
                        <p style="text-align: justify; font-weight: 500;">Ce chantier reflète le savoir-faire de GFI-CO sur les programmes immobiliers d'envergure, où la qualité des finitions conditionne la satisfaction du client final.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/villa-palmera/1.jpg') }}" alt="Projet Villa Palmera" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/1.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/2.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/3.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/4.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/5.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/6.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/7.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/8.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
            <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-palmera/9.jpg') }}">
                <div class="swiper-slide-caption"><div class="container"></div></div>
            </div>
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}