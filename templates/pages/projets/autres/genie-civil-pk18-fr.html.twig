{# templates/pages/projets/autres/genie-civil-pk18-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Génie Civil PK18 - Plateforme livrée en 6 jours{% endblock %}

{% block description %}Découvrez le projet de génie civil PK18 : plateforme de 3000 m² livrée en 6 jours pour une cérémonie officielle. Terrassement, nivellement et compactage.{% endblock %}

{% block bread_subtitle %}Second Œuvre & Aménagements{% endblock %}
{% block bread_title %}Génie Civil PK18 - Une plateforme livrée en 6 jours pour une cérémonie officielle{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_autres', {_locale: 'fr'}) }}">Second Œuvre & Aménagements</a></li>
    <li class="active">Génie Civil PK18</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Le Bâtisseur P/C PARU</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Localisation</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Abobo PK18, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature des travaux</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Nivellement d'une plateforme de 3 000 m²</a></li>
                        <li><a href="#">Terrassement de la plateforme</a></li>
                        <li><a href="#">Compactage de la plateforme</a></li>
                        <li><a href="#">Reprofilage des voies d'accès</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Prestations</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Travaux de génie civil pour la cérémonie de pose de la première pierre</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Rôle de GFI-CO</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Entreprise d'exécution</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Génie civil · Abobo, PK18 · Délai : 6 jours</h5>
                        <p style="text-align: justify;">Certains chantiers n'admettent aucun retard. Mandatée par l'entreprise Le Bâtisseur pour le compte de PARU, GFI-CO a réalisé les travaux de génie civil préparatoires à la cérémonie de pose de la première pierre d'une unité de traitement des eaux usées à Abobo PK18, présidée par Son Excellence le Premier Ministre, M. Patrick Achi.</p>
                        <p style="text-align: justify;">Terrassement, nivellement et compactage d'une plateforme de 3 000 m², reprofilage des voies d'accès : l'ensemble des travaux a été exécuté en seulement 6 jours, en pleine saison des pluies, pour permettre le bon déroulement de la cérémonie officielle.</p>
                        <p style="text-align: justify; font-weight: 500;">Un chantier qui prouve la capacité de GFI-CO à mener des travaux de génie civil sous forte contrainte de délai, pour des événements institutionnels de premier plan.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/4-autres/pk18/7.jpeg') }}" alt="Travaux de Génie civil PK18" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..9 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/4-autres/pk18/' ~ i ~ '.jpeg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}