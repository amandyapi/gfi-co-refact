{# templates/pages/projets/autres/amenagement-bureau-giz-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Aménagement Bureau GIZ - Invest For Jobs{% endblock %}

{% block description %}Découvrez le projet d'aménagement du bureau GIZ pour Invest For Jobs à Riviera 2, Abidjan. Rénovation complète par GFI-CO.{% endblock %}

{% block bread_subtitle %}Second Œuvre & Aménagements{% endblock %}
{% block bread_title %}Aménagement Bureau GIZ - Une rénovation complète pour Invest For Jobs, Riviera 2{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_autres', {_locale: 'fr'}) }}">Second Œuvre & Aménagements</a></li>
    <li class="active">Aménagement Bureau GIZ</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">GIZ / Invest For Jobs</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Localisation</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Riviera 2, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature des travaux</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Rénovation complète de bureaux</a></li>
                        <li><a href="#">Aménagement intérieur</a></li>
                        <li><a href="#">Second œuvre</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Rôle de GFI-CO</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Entreprise d'exécution</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Aménagement tertiaire · Riviera 2, Abidjan</h5>
                        <p style="text-align: justify;">À l'issue d'un appel d'offres, nous avons été retenus pour la rénovation complète des nouveaux bureaux d'Invest For Jobs, à Riviera 2, Abidjan. Un chantier tertiaire mené pour répondre aux exigences fonctionnelles et esthétiques d'une organisation internationale.</p>
                        <p style="text-align: justify;">Ce projet démontre la capacité de GFI-CO à intervenir sur des chantiers tertiaires de qualité, en respectant les normes et les délais exigés par les institutions internationales.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/4-autres/giz/9.jpg') }}" alt="Aménagement Bureau GIZ" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..9 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/4-autres/giz/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}