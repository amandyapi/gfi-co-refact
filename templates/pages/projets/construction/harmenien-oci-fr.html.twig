{# templates/pages/projets/construction/harmenien-oci-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Projet Hamanien de OCI - 17 sites de pylônes télécoms{% endblock %}

{% block description %}Découvrez le projet Hamanien de OCI : mission complète de bureau d'études et de génie civil pour la construction de 17 sites de pylônes télécoms en Côte d'Ivoire.{% endblock %}

{% block bread_subtitle %}Construction{% endblock %}
{% block bread_title %}Projet Hamanien de OCI - 17 sites de pylônes télécoms, du bureau d'études aux travaux{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_construction', {_locale: 'fr'}) }}">Construction</a></li>
    <li class="active">Projet Hamanien de OCI</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">NGSER P/C OCI</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Localisation</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature des travaux</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Mission de bureau d'études : visite draft, conception de plans 2D</a></li>
                        <li><a href="#">Implantation des sites</a></li>
                        <li><a href="#">Établissement des rapports APD et DQE</a></li>
                        <li><a href="#">Visite et suivi de chantier</a></li>
                        <li><a href="#">Travaux de génie civil et montage de pylônes 40 et 60 mètres</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Durée d'exécution</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">5 mois</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Rôle de GFI-CO</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Bureau d'Études et de Génie civil</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Génie civil & infrastructures · Côte d'Ivoire · Mission de 5 mois</h5>
                        <p style="text-align: justify;">Au-delà de l'immobilier résidentiel, GFI-CO met son expertise technique au service des infrastructures télécoms. Mandatée par NGSER pour le compte d'OCI, notre équipe a assuré une mission complète de bureau d'études et de génie civil pour la construction de 17 sites de pylônes, hauts de 40 à 60 mètres.</p>
                        <p style="text-align: justify;">La mission a couvert la conception des plans 2D et d'implantation des sites, l'établissement des rapports d'Avant-Projet Détaillé (APD) et du Devis Quantitatif Estimatif (DQE), puis la réalisation des travaux de génie civil et le montage de pylônes de 40 mètres — le tout en 5 mois, avec un suivi de chantier rigoureux garantissant qualité et conformité.</p>
                        <p style="text-align: justify; font-weight: 500;">Un projet qui démontre la polyvalence de GFI-CO et sa capacité à intervenir sur des infrastructures lourdes, au-delà de son cœur de métier immobilier.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/oci/6.jpg') }}" alt="Projet Harmenien de OCI" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..7 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/oci/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}