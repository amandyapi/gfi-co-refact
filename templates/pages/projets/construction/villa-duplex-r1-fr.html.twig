{# templates/pages/projets/construction/villa-duplex-r1-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Villa Duplex R+1 à Bingerville{% endblock %}

{% block description %}Découvrez le projet de construction d'une villa duplex R+1 à Bingerville par GFI-CO. Gros œuvre et second œuvre, maîtrise d'ouvrage complète.{% endblock %}

{% block bread_subtitle %}Construction{% endblock %}
{% block bread_title %}Villa Duplex R+1 à Bingerville - De l'étude à l'exécution, un même engagement{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'fr'}) }}">Projets</a></li>
    <li><a href="{{ path('app_projets_construction', {_locale: 'fr'}) }}">Construction</a></li>
    <li class="active">Villa Duplex R+1 à Bingerville</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Particulier (diaspora)</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Localisation</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Bingerville, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature des travaux</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Achat du foncier - ACD</a></li>
                        <li><a href="#">Conception plan + Permis de construire</a></li>
                        <li><a href="#">Études géotechnique et structure</a></li>
                        <li><a href="#">Construction : Gros et Seconds Œuvres</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Scope</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Construction clé en main d'une villa duplex R+1, 10 pièces, moyen standing</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Durée d'exécution</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">12 mois</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Rôle de GFI-CO</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Maîtrise d'ouvrage</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>À propos de ce projet</h3>
                        <h5 style="text-align: justify; font-style: italic;">Construction · Bingerville  ·  Gros œuvre & second œuvre</h5>
                        <p style="text-align: justify;">Après la conception des plans et l'obtention du permis de construire, place à l'exécution. GFI-CO poursuit sa mission de maîtrise d'ouvrage sur cette villa duplex R+1 à Bingerville, en engageant les travaux de gros œuvre, bientôt suivis du second œuvre.</p>
                        <p style="text-align: justify;">Cette continuité entre étude et chantier illustre notre exigence : livrer un projet fidèle au plan initial, dans le respect des normes de construction et des délais annoncés. Une méthode que GFI-CO déploie pour accompagner sereinement ses clients de la diaspora comme ses clients nationaux, en toute transparence et sans stress, du premier plan à la remise des clés.</p>
                        <p style="text-align: justify; font-weight: 500;">Demande de devis.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/villa-duplex/2.jpg') }}" alt="Projet Villa Duplex R+1" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Galerie -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..10 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-duplex/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Vous avez un projet similaire ? <span class="fw-bold" style="color:#fff;">Parlons-en ensemble</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'fr'}) }}" style="border-color:#fff; color:#fff;">Nous contacter</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}