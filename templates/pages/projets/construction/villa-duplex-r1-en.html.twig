{# templates/pages/projets/construction/villa-duplex-r1-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Duplex Villa R+1 in Bingerville{% endblock %}

{% block description %}Discover the construction project of an R+1 duplex villa in Bingerville by GFI-CO. Structural and finishing works, complete project management.{% endblock %}

{% block bread_subtitle %}Construction{% endblock %}
{% block bread_title %}Duplex Villa R+1 in Bingerville - From study to execution, the same commitment{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li><a href="{{ path('app_projets_construction', {_locale: 'en'}) }}">Construction</a></li>
    <li class="active">Duplex Villa R+1 in Bingerville</li>
{% endblock %}

{% block page %}
    <!-- Overview -->
    <section class="section section-sm bg-gray-100">
        <div class="container">
            <div class="owl-carousel owl-carousel-centered-pagination" data-items="1" data-sm-items="2" data-md-items="3" data-lg-items="4" data-dots="true" data-stage-padding="0" data-loop="false" data-margin="30" data-mouse-drag="false">
                <div class="item">
                    <h4>Client</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Individual (diaspora)</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Location</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Bingerville, Abidjan - Côte d'Ivoire</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Nature of works</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Land purchase - ACD</a></li>
                        <li><a href="#">Design plan + Building permit</a></li>
                        <li><a href="#">Geotechnical and structural studies</a></li>
                        <li><a href="#">Construction: Structural and Finishing works</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Scope</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Turnkey construction of an R+1 duplex villa, 10 rooms, mid-range</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>Execution time</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">12 months</a></li>
                    </ul>
                </div>
                <div class="item">
                    <h4>GFI-CO's role</h4>
                    <ul class="list-inline-comma list-inline-comma-default">
                        <li><a href="#">Project management</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- About This Project -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h3>About this project</h3>
                        <h5 style="text-align: justify; font-style: italic;">Construction · Bingerville · Structural & finishing works</h5>
                        <p style="text-align: justify;">After the design of the plans and obtaining the building permit, it's time for execution. GFI-CO continues its project management mission on this R+1 duplex villa in Bingerville, starting the structural works, soon to be followed by the finishing works.</p>
                        <p style="text-align: justify;">This continuity between study and site illustrates our commitment: delivering a project faithful to the initial plan, in compliance with construction standards and announced deadlines. A method that GFI-CO deploys to support its diaspora clients as well as its national clients with peace of mind, in full transparency and without stress, from the first plan to the handover of keys.</p>
                        <p style="text-align: justify; font-weight: 500;">Quote request.</p>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/villa-duplex/2.jpg') }}" alt="Duplex Villa R+1 Project" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery -->
    <section class="section swiper-container swiper-slider swiper-slider-tiny text-center" data-loop="true" data-slide-effect="fade" data-autoplay="false" data-simulate-touch="true"> 
        <div class="swiper-wrapper">
            {% for i in 1..10 %}
                <div class="swiper-slide vertical" data-slide-bg="{{ asset('assets/images/projets/3-construction/villa-duplex/' ~ i ~ '.jpg') }}">
                    <div class="swiper-slide-caption"><div class="container"></div></div>
                </div>
            {% endfor %}
        </div>
        <div class="swiper-pagination-outer container">
            <div class="swiper-pagination swiper-pagination-modern swiper-pagination-marked" data-index-bullet="true"></div>
        </div>
    </section>
    
    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer" style="color:#fff;">
                            <span class="wow slideInRight">Do you have a similar project? <span class="fw-bold" style="color:#fff;">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-lg button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}" style="border-color:#fff; color:#fff;">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}