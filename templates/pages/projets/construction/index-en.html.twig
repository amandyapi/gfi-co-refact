{# templates/pages/projets/construction/index-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Construction{% endblock %}

{% block description %}Discover our construction projects: civil engineering, telecom towers, duplex villas. GFI-CO builds sustainable, quality projects.{% endblock %}

{% block bread_subtitle %}Projects{% endblock %}
{% block bread_title %}Construction{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_projets_index', {_locale: 'en'}) }}">Projects</a></li>
    <li class="active">Construction</li>
{% endblock %}

{% block page %}
    <!-- Project 1: OCI Harmonized Housing -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h4>OCI Harmonized Housing Project - 17 telecom tower sites, from design office to works</h4>
                        <h5 style="text-align: justify; font-style: italic;">Civil engineering & infrastructure · Côte d'Ivoire · 5-month mission</h5>
                        <p style="text-align: justify;">Beyond residential real estate, GFI-CO puts its technical expertise at the service of telecom infrastructure. Mandated by NGSER on behalf of OCI, our team carried out a complete design office and civil engineering mission for the construction of 17 tower sites, 40 to 60 metres high.</p>
                        <br>
                        <a href="{{ path('app_projets_construction_oci', {_locale: 'en'}) }}">
                            <span style="color:#fdb900; font-weight:400; font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Learn more →</span>
                        </a>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/oci/6.jpg') }}" alt="OCI Harmonized Housing Project" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>
    
    <!-- Fixed image section with parallax effect -->
    <section class="section swiper-container text-center" style="position: relative; overflow: hidden; height: 50vh; background-attachment: fixed; background-image: url('{{ asset('assets/images/single-project-slide-3-1920x760.jpg') }}'); background-size: cover; background-position: center;"> 
        <div class="swiper-wrapper" style="height: 100%;">
            <div class="swiper-slide" style="height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.4);">
                <div class="swiper-slide-caption" style="width: 100%;">
                    <div class="container">
                        <h2 style="color:#fff; font-size:2.5rem; font-weight:700; text-transform:uppercase; letter-spacing:2px;">Construction</h2>
                        <p style="color:#fff; font-size:1.1rem; max-width:600px; margin:15px auto 0;">Tailor-made constructions combining quality and durability</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Project 2: Duplex Villa R+1 -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row">
                <div class="col-md-10 col-lg-6 col-xl-6">
                    <div class="inset-left-2"> 
                        <h4>Duplex Villa R+1 in Bingerville - From study to execution, the same commitment</h4>
                        <h5 style="text-align: justify; font-style: italic;">Construction · Bingerville · Structural & finishing works</h5>
                        <p style="text-align: justify;">After the design of the plans and obtaining the building permit, it's time for execution. GFI-CO continues its project management mission on this R+1 duplex villa in Bingerville, starting the structural works, soon to be followed by the finishing works.</p>
                        <br>
                        <a href="{{ path('app_projets_construction_villa_duplex', {_locale: 'en'}) }}">
                            <span style="color:#fdb900; font-weight:400; font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Learn more →</span>
                        </a>
                    </div>
                </div>
                <div class="col-md-10 col-lg-6">
                    <img src="{{ asset('assets/images/projets/3-construction/villa-duplex/2.jpg') }}" alt="Duplex Villa R+1 Project" style="width:100%; height:auto; border-radius:8px;">
                </div>
            </div>
        </div>
    </section>

    <!-- Fixed image section with parallax effect 2 -->
    <section class="section swiper-container text-center" style="position: relative; overflow: hidden; height: 50vh; background-attachment: fixed; background-image: url('{{ asset('assets/images/single-project-slide-1-1920x760.jpg') }}'); background-size: cover; background-position: center;"> 
        <div class="swiper-wrapper" style="height: 100%;">
            <div class="swiper-slide" style="height: 100%; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.4);">
                <div class="swiper-slide-caption" style="width: 100%;">
                    <div class="container">
                        <h2 style="color:#fff; font-size:2.5rem; font-weight:700; text-transform:uppercase; letter-spacing:2px;">Construction</h2>
                        <p style="color:#fff; font-size:1.1rem; max-width:600px; margin:15px auto 0;">Tailor-made constructions combining quality and durability</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section section-xs bg-primary text-center">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-sm-10 col-md-12">
                    <div class="box-cta-thin">
                        <h4 class="wow-outer">
                            <span class="wow slideInRight">Do you have a construction project? <span class="fw-bold">Let's talk about it together</span></span>
                        </h4>
                        <div class="wow-outer button-outer">
                            <a class="button button-black-outline button-winona wow slideInLeft" href="{{ path('app_contact', {_locale: 'en'}) }}">Contact us</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}