{% extends 'layout-multi.html.twig' %}

{% block title %}sol2u | À propos
{% endblock %}

{% block main %}
	<section id="hero" class="hero section dark-background">

		<div
			id="hero-carousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
			<!-- ===== Carousel Item 2 : Services et expertises ===== -->
			<div class="carousel-item active">
				<img src="{{ asset('assets/img/hero-carousel/hero-carousel-3.jpg') }}" alt="">
				<div class="carousel-container" style="position: relative;top: 70%;">
					<h2>Qui sommes-nous?</h2>
				</div>
			</div>
			<!-- End Carousel Item -->

		</div>

	</section>
	<!-- /Hero Section -->

	<!-- About 2 Section -->
	<section
		id="about-2" class="about-2 section">

		<!-- Section Title -->
		<div class="container section-title" data-aos="fade-up">
			<h2>À Propos</h2>
			<p>SOL2U : BI & IA Makers, Digital Makers</p>
		</div>
		<!-- End Section Title -->

		<div class="container" data-aos="fade-up">

			<div class="row g-4 g-lg-5" data-aos="fade-up" data-aos-delay="200">

				<div class="col-lg-5">
					<div class="about-img">
						<img src="{{ asset('assets/img/about-portrait.jpg') }}" class="img-fluid" alt="">
					</div>
				</div>

				<div class="col-lg-7">
					<h3 class="pt-0 pt-lg-5">SOL2U : BI & Digital Makers</h3>

					<!-- Tabs -->
					<!-- End Tabs -->

					<!-- Tab Content -->
						<div class="tab-content"> <div class="tab-pane fade show active" id="about-2-tab1">
							<p class="fst-italic" style="text-align: justify;">
								Nous sommes des "Digital Makers" : des architectes et des artisans de votre ambition numérique.
							</p>
							<br>
							<p style="text-align: justify;">
								Notre Approche : La Co-création, seul on va vite, ensemble on va loin. Nous allons au-delà du rôle d'une ESN classique. Nous nous immergeons dans vos défis pour co-créer des solutions digitales qui vous correspondent : flexibles, pérennes et sans dépendance technologique.
								<br>Nous construisons votre projet avec vous, mais nous nous assurons surtout que vous puissiez vous l'approprier.
							</p>
							<br>
							<p style="text-align: justify;">
								SOL2U (Solution To You) est une Entreprise de Services Numériques (ESN) spécialisée dans la transformation digitale, l’intégration de solutions métiers et la valorisation des données.<br>
								Nous accompagnons les entreprises et administrations dans la modernisation de leurs processus, l'automatisation, la digitalisation documentaire et l’analyse de données à grande échelle.
							</p>
							<br>
							<p style="text-align: justify;">
								Notre ambition est simple : apporter des solutions fiables, adaptées et évolutives, centrées sur les besoins réels de nos clients.
							</p>
						</div>

					</div>
					<!-- End Tab 1 Content -->

				</div>

			</div>

		</div>

	</div>

</section>
<!-- /About 2 Section -->{% endblock %}
