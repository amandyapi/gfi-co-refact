{# templates/pages/blog/blog-fr.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO GROUP | Actualités{% endblock %}

{% block description %}Retrouvez toutes les actualités de GFI-CO GROUP : projets immobiliers, partenariats, événements et innovations.{% endblock %}

{% block bread_subtitle %}Actualités{% endblock %}
{% block bread_title %}Actualités{% endblock %}

{% block bread_items %}
    <li class="active">Actualités</li>
{% endblock %}

{% block page %}
    <section class="section section-lg">
        <div class="container">
            <article class="blog-layout">
                <div class="blog-layout-main">
                    <div class="row row-50 row-xxl-70">
                        {% for post in posts %}
                            <div class="col-sm-6">
                                <article class="post-classic">
                                    {% if post.imageUrl %}
                                        <a class="post-classic-media" href="{{ path('app_blog_single', {_locale: 'fr', slug: post.slug}) }}">
                                            <img src="{{ asset('assets/uploads/blog/' ~ post.imageUrl) }}" alt="{{ post.title }}" width="370" height="264"/>
                                        </a>
                                    {% endif %}
                                    <ul class="post-classic-meta">
                                        {% if post.category %}
                                            <li><a class="button-winona" href="{{ path('app_blog_category', {_locale: 'fr', category: post.category}) }}">{{ post.category }}</a></li>
                                        {% endif %}
                                        {% if post.publishedAt %}
                                            <li><time datetime="{{ post.publishedAt|date('Y-m-d') }}">{{ post.publishedAt|date('d M Y') }}</time></li>
                                        {% endif %}
                                    </ul>
                                    <h4 class="post-classic-title">
                                        <a href="{{ path('app_blog_single', {_locale: 'fr', slug: post.slug}) }}">{{ post.title }}</a>
                                    </h4>
                                </article>
                            </div>
                        {% else %}
                            <div class="col-12 text-center">
                                <p>Aucun article disponible pour le moment.</p>
                            </div>
                        {% endfor %}
                    </div>

                    {% if totalPages > 1 %}
                        <div class="pagination">
                            {% for p in 1..totalPages %}
                                <div class="page-item {{ p == currentPage ? 'active' : '' }}">
                                    <a class="page-link button-winona" href="{{ path('app_blog_index', {_locale: 'fr', page: p}) }}">{{ p }}</a>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="blog-layout-aside">
                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Rechercher</p>
                        <form class="rd-form rd-search rd-search-classic" action="{{ path('app_blog_search', {_locale: 'fr'}) }}" method="GET">
                            <div class="form-wrap">
                                <input class="form-input" id="rd-search-form-input" type="text" name="s" autocomplete="off">
                                <label class="form-label" for="rd-search-form-input">Rechercher</label>
                            </div>
                            <button class="rd-search-submit" type="submit"></button>
                        </form>
                    </div>

                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Archives</p>
                        <ul class="list-marked">
                            {% for archive in archives %}
                                <li><a href="#">{{ archive.label }} ({{ archive.count }})</a></li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">À propos</p>
                        <p>GFI-CO GROUP est un acteur majeur de la promotion et construction immobilière durable en Côte d'Ivoire et en Guinée. Découvrez nos actualités et nos réalisations.</p>
                    </div>

                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Catégories</p>
                        <ul class="list-marked">
                            {% for category in categories %}
                                <li><a href="{{ path('app_blog_category', {_locale: 'fr', category: category}) }}">{{ category }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </article>
        </div>
    </section>
{% endblock %}