                        <p>GFI-CO GROUP est un acteur majeur de la promotion et construction immobilière durable en Côte d'Ivoire et en Guinée. Découvrez nos actualités et nos réalisations.</p>
                    </div>
                    
                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Catégories</p>
                        <ul class="list-marked">
                            <li><a href="#">Promotion immobilière</a></li>
                            <li><a href="#">Construction</a></li>
                            <li><a href="#">Design & Architecture</a></li>
                            <li><a href="#">Investissement</a></li>
                            <li><a href="#">Partenariats</a></li>
                        </ul>
                    </div>
                    
                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Tags</p>
                        <ul class="list-inline-comma">
                            <li><a href="#">Actualité</a></li>
                            <li><a href="#">Immobilier</a></li>
                            <li><a href="#">Construction</a></li>
                            <li><a href="#">Design</a></li>
                            <li><a href="#">Architecture</a></li>
                            <li><a href="#">Partenariat</a></li>
                        </ul>
                    </div>
                </div>
            </article>
        </div>
    </section>
{% endblock %}