{# templates/pages/blog/blog.html.twig #}
{% extends 'layout-pages-fr.html.twig' %}

{% block title %}GFI-CO GROUP | Actualités - Blog immobilier{% endblock %}

{% block description %}Retrouvez toutes les actualités de GFI-CO GROUP : projets immobiliers, partenariats, événements et innovations dans le secteur de la construction en Côte d'Ivoire et en Guinée.{% endblock %}

{% block bread_subtitle %}Nos actualités{% endblock %}
{% block bread_title %}Blog & actualités{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_blog_index') }}">Actualités</a></li>
    <li class="active">Toutes nos actualités</li>
{% endblock %}

{% block page %}
    <section class="section section-lg">
        <div class="container">
            <article class="blog-layout">
                <div class="blog-layout-main">
                    <div class="row row-50 row-xxl-70">
                        <!-- Post 1: Al HABTOOR -->
                        <div class="col-sm-6">
                            <article class="post-classic">
                                <a class="post-classic-media" href="{{ path('app_blog_single', {slug: 'al-habtoor'}) }}">
                                    <img src="{{ asset('assets/images/sidebar-blog-1-370x264.jpg') }}" alt="Al HABTOOR" width="370" height="264"/>
                                </a>
                                <ul class="post-classic-meta">
                                    <li><a class="button-winona" href="#">Actualité</a></li>
                                    <li><time datetime="2021-12-29">29 déc. 2021 à 12h16</time></li>
                                </ul>
                                <h4 class="post-classic-title">
                                    <a href="{{ path('app_blog_single', {slug: 'al-habtoor'}) }}">Al HABTOOR, le portefeuille de marques de GFI-CO</a>
                                </h4>
                            </article>
                        </div>
                        
                        <!-- Post 2: Expo Dubaï -->
                        <div class="col-sm-6">
                            <article class="post-classic">
                                <a class="post-classic-media" href="{{ path('app_blog_single', {slug: 'expo-dubai'}) }}">
                                    <img src="{{ asset('assets/images/sidebar-blog-2-370x264.jpg') }}" alt="Expo Dubaï" width="370" height="264"/>
                                </a>
                                <ul class="post-classic-meta">
                                    <li><a class="button-winona" href="#">Actualité</a></li>
                                    <li><time datetime="2021-12-29">29 déc. 2021 à 11h28</time></li>
                                </ul>
                                <h4 class="post-classic-title">
                                    <a href="{{ path('app_blog_single', {slug: 'expo-dubai'}) }}">Expo Dubaï 2020 : GFI-CO à la conquête de nouveaux marchés immobiliers</a>
                                </h4>
                            </article>
                        </div>
                        
                        <!-- Post 3: Déjeuner d'Affaires -->
                        <div class="col-sm-6">
                            <article class="post-classic">
                                <a class="post-classic-media" href="{{ path('app_blog_single', {slug: 'dejeuner-affaires'}) }}">
                                    <img src="{{ asset('assets/images/sidebar-blog-3-370x264.jpg') }}" alt="Déjeuner d'Affaires" width="370" height="264"/>
                                </a>
                                <ul class="post-classic-meta">
                                    <li><a class="button-winona" href="#">Actualité</a></li>
                                    <li><time datetime="2021-12-29">29 déc. 2021 à 11h21</time></li>
                                </ul>
                                <h4 class="post-classic-title">
                                    <a href="{{ path('app_blog_single', {slug: 'dejeuner-affaires'}) }}">Déjeuner d'Affaires</a>
                                </h4>
                            </article>
                        </div>
                        
                        <!-- Post 4: Anniversaire -->
                        <div class="col-sm-6">
                            <article class="post-classic">
                                <a class="post-classic-media" href="{{ path('app_blog_single', {slug: 'anniversaire'}) }}">
                                    <img src="{{ asset('assets/images/sidebar-blog-4-370x264.jpg') }}" alt="Anniversaire GFI-CO" width="370" height="264"/>
                                </a>
                                <ul class="post-classic-meta">
                                    <li><a class="button-winona" href="#">Actualité</a></li>
                                    <li><time datetime="2021-12-29">29 déc. 2021 à 11h07</time></li>
                                </ul>
                                <h4 class="post-classic-title">
                                    <a href="{{ path('app_blog_single', {slug: 'anniversaire'}) }}">Anniversaire GFI CO</a>
