                            </article>
                        </div>
                    </div>
                    
                    <!-- Pagination -->
                    <div class="pagination">
                        <div class="page-item active">
                            <a class="page-link button-winona" href="{{ path('app_blog_index') }}">1</a>
                        </div>
                        <div class="page-item">
                            <a class="page-link button-winona" href="{{ path('app_blog_index') }}?page=2">2</a>
                        </div>
                        <div class="page-item">
                            <a class="page-link button-winona" href="{{ path('app_blog_index') }}?page=3">3</a>
                        </div>
                    </div>
                </div>
                
                <!-- Sidebar -->
                <div class="blog-layout-aside">
                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Rechercher</p>
                        <form class="rd-form rd-search rd-search-classic" action="{{ path('app_search') }}" method="GET">
                            <div class="form-wrap">
                                <input class="form-input" id="rd-search-form-input" type="text" name="s" autocomplete="off">
                                <label class="form-label" for="rd-search-form-input">Rechercher</label>
                            </div>
                            <button class="rd-search-submit" type="submit"></button>
                        </form>
                    </div>
                    
                    <div class="blog-layout-aside-item">
                        <p class="blog-layout-aside-title">Archives</p>
                        <ul class="list-marked">
                            <li><a href="#">Décembre 2021</a></li>
