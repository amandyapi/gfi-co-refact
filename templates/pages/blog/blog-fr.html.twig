                                    <img src="{{ asset('assets/images/sidebar-blog-5-370x264.jpg') }}" alt="Partenariat" width="370" height="264"/>
                                </a>
                                <ul class="post-classic-meta">
                                    <li><a class="button-winona" href="#">Actualité</a></li>
                                    <li><time datetime="2021-12-29">29 déc. 2021 à 10h56</time></li>
                                </ul>
                                <h4 class="post-classic-title">
                                    <a href="{{ path('app_blog_single', {slug: 'partenariat-archi-union'}) }}">Partenariat GFI-CO SARL-Cabinet ARCHI-UNION</a>
