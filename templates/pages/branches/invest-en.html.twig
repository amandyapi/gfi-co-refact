{# templates/pages/branches/invest-en.html.twig #}
{% extends 'layout-pages.html.twig' %}

{% block title %}GFI-CO Invest | Real estate investment and asset management{% endblock %}

{% block description %}GFI-CO Invest supports you in your real estate investments in Côte d'Ivoire and Guinea. Strategy, acquisition, risk management and transparency.{% endblock %}

{% block bread_subtitle %}Our branches{% endblock %}
{% block bread_title %}GFI-CO Invest{% endblock %}

{% block bread_items %}
    <li><a href="{{ path('app_branches_index', {_locale: 'en'}) }}">Our branches</a></li>
    <li class="active">Invest</li>
{% endblock %}

{% block page %}
    <!-- About This Service -->
    <section class="section section-lg">
        <div class="container">
            <div class="row row-50 justify-content-center justify-content-lg-between flex-lg-row-reverse">
                <div class="col-lg-6 col-xl-5">
                    <div class="inset-right-3">
                        <h3>GFI-CO Invest</h3>
                        <h5 style="text-align: justify;">Investing with method</h5>
                        <p style="text-align: justify;">Identifying opportunities, acquiring, rigorously managing assets and risks: sustainable returns, designed for the long term. Our investment branch covers the residential, commercial and industrial sectors, with full transparency at every stage of the process.</p>
                        <p style="text-align: justify;">We support individual and institutional investors in building and managing their real estate portfolios, favouring solid asset strategies tailored to their objectives.</p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img class="img-responsive" src="{{ asset('assets/images/branches/invest/2.jpg') }}" alt="GFI-CO Invest" width="551" height="385"/>
                </div>
            </div>
        </div>
    </section>

    <!-- Our approach -->
    <section class="section section-lg bg-gray-100">
        <div class="container">
            <h3 class="text-center wow-outer">
                <span class="wow slideInDown">Our approach</span>
            </h3>
            <div class="row row-30">
                <div class="col-sm-6 col-lg-4 wow-outer">
                    <article class="box-minimal">
                        <div class="box-minimal-icon fa-solid fa-bullseye wow fadeIn"></div>
                        <div class="box-minimal-main wow-outer">
                            <h4 class="box-minimal-title wow slideInDown">Investment strategy</h4>
                            <p class="wow fadeInUpSmall">We define a tailor-made strategy that takes into account your objectives, your investment horizon and your risk appetite.</p>
                        </div>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-4 wow-outer">
                    <article class="box-minimal">
                        <div class="box-minimal-icon fa-solid fa-magnifying-glass-chart wow fadeIn" data-wow-delay=".1s"></div>
                        <div class="box-minimal-main wow-outer">
                            <h4 class="box-minimal-title wow slideInDown" data-wow-delay=".1s">Research and analysis</h4>
                            <p class="wow fadeInUpSmall" data-wow-delay=".1s">An in-depth market analysis to identify the best opportunities and assess their return potential.</p>
                        </div>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-4 wow-outer">
                    <article class="box-minimal">
                        <div class="box-minimal-icon fa-solid fa-file-invoice-dollar wow fadeIn" data-wow-delay=".2s"></div>
                        <div class="box-minimal-main wow-outer">
                            <h4 class="box-minimal-title wow slideInDown" data-wow-delay=".2s">Property acquisition</h4>
                            <p class="wow fadeInUpSmall" data-wow-delay=".2s">Comprehensive support throughout the acquisition process, from negotiation to signing, including legal and financial aspects.</p>
                        </div>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-4 wow-outer">
                    <article class="box-minimal">
                        <div class="box-minimal-icon fa-solid fa-shield-halved wow fadeIn" data-wow-delay=".3s"></div>
                        <div class="box-minimal-main wow-outer">
                            <h4 class="box-minimal-title wow slideInDown" data-wow-delay=".3s">Risk management</h4>
                            <p class="wow fadeInUpSmall" data-wow-delay=".3s">Rigorous risk assessment and the implementation of diversification strategies to secure your assets.</p>
                        </div>
                    </article>
                </div>
                <div class="col-sm-6 col-lg-4 wow-outer">
                    <article class="box-minimal">
                        <div class="box-minimal-icon fa-solid fa-comments wow fadeIn" data-wow-delay=".4s"></div>
                        <div class="box-minimal-main wow-outer">
                            <h4 class="box-minimal-title wow slideInDown" data-wow-delay=".4s">Transparency and communication</h4>
                            <p class="wow fadeInUpSmall" data-wow-delay=".4s">Clear and regular reports on the performance of your investments and smooth communication at every stage.</p>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section section-md bg-primary text-center">
        <div class="container">
            <div class="box-cta-1">
                <h3>Want to invest in real estate? <span class="fw-bold">Let's build your strategy</span></h3>
                <a class="button button-lg button-black-outline button-winona" href="{{ path('app_contact', {_locale: 'en'}) }}">Contact us</a>
            </div>
        </div>
    </section>
{% endblock %}