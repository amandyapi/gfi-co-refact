{% extends 'layout-admin.html.twig' %}

{% block title %}Articles de blog - Administration GFI-CO{% endblock %}
{% block page_title %}Gestion des articles{% endblock %}

{% block body %}
    <div class="admin-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
            <h5 style="margin:0;">Liste des articles</h5>
            <a href="{{ path('app_admin_blog_new') }}" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nouvel article</a>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Catégorie</th>
                    <th>Langue</th>
                    <th>Publié le</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td>{{ post.title }}</td>
                        <td>{{ post.category|default('—') }}</td>
                        <td>{{ post.locale|upper }}</td>
                        <td>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '—' }}</td>
                        <td>
                            <a href="{{ path('app_admin_blog_edit', {id: post.id}) }}" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i></a>
                            <form method="post" action="{{ path('app_admin_blog_delete', {id: post.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cet article ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_blog_' ~ post.id) }}">
                                <button class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" style="text-align:center;">Aucun article.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}