{% extends 'layout-admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvel' }} article - Administration GFI-CO{% endblock %}
{% block page_title %}{{ isEdit ? 'Modifier un article' : 'Créer un article' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
        .form-control { width: 100%; padding: 10px 12px; border: 1px solid #dde3ea; border-radius: 6px; font-size: 0.95rem; }
        .form-control:focus { outline: none; border-color: #f68b1e; box-shadow: 0 0 0 3px rgba(246,139,30,.15); }
        .form-error { color: #b71c1c; font-size: 0.85rem; margin-top: 4px; }
        .form-row { display: flex; gap: 20px; }
        .form-row > * { flex: 1; }
        .tox-tinymce { border-radius: 6px !important; }
    </style>
{% endblock %}

{% block body %}
    <div class="admin-card">
        <form method="post" enctype="multipart/form-data">
            <div class="form-row">
                <div class="form-group" style="flex: 2;">
                    <label for="title">Titre *</label>
                    <input type="text" id="title" name="title" class="form-control" value="{{ data.title }}" required>
                    {% if errors.title is defined %}<div class="form-error">{{ errors.title }}</div>{% endif %}
                </div>
                <div class="form-group" style="flex: 1;">
                    <label for="slug">Slug <small>(auto si vide)</small></label>
                    <input type="text" id="slug" name="slug" class="form-control" value="{{ data.slug }}">
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="category">Catégorie</label>
                    <input type="text" id="category" name="category" class="form-control" value="{{ data.category }}">
                </div>
                <div class="form-group">
                    <label for="locale">Langue *</label>
                    <select id="locale" name="locale" class="form-control">
                        <option value="fr" {{ data.locale == 'fr' ? 'selected' : '' }}>Français</option>
                        <option value="en" {{ data.locale == 'en' ? 'selected' : '' }}>Anglais</option>
                    </select>
                    {% if errors.locale is defined %}<div class="form-error">{{ errors.locale }}</div>{% endif %}
                </div>
                <div class="form-group">
                    <label for="publishedAt">Date de publication</label>
                    <input type="date" id="publishedAt" name="publishedAt" class="form-control" value="{{ data.publishedAt }}">
                    {% if errors.publishedAt is defined %}<div class="form-error">{{ errors.publishedAt }}</div>{% endif %}
                </div>
            </div>

            <div class="form-group">
                <label for="excerpt">Extrait</label>
                <textarea id="excerpt" name="excerpt" class="form-control" rows="3">{{ data.excerpt }}</textarea>
            </div>

            <div class="form-group">
                <label for="content">Contenu *</label>
                <textarea id="content" name="content" class="form-control" rows="12">{{ data.content }}</textarea>
                {% if errors.content is defined %}<div class="form-error">{{ errors.content }}</div>{% endif %}
            </div>

            <div class="form-group">
                <label for="imageFile">Image</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/*">
                {% if isEdit and blog.imageUrl %}
                    <p style="margin-top:8px;"><small>Image actuelle :</small><br>
                        <img src="{{ asset('uploads/blog/' ~ blog.imageUrl) }}" alt="" style="max-width:150px; margin-top:6px; border-radius:4px;">
                    </p>
                {% endif %}
            </div>

            <div style="margin-top:20px; display:flex; gap:10px;">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_admin_blog_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- TinyMCE self-hosted (pas de clé API) -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js"></script>
    <script>
        tinymce.init({
            selector: '#content',
            height: 500,
            menubar: true,
            plugins: 'lists link image table code fullscreen preview media wordcount',
            toolbar: 'undo redo | blocks | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image table | code fullscreen preview',
            content_style: 'body { font-family: Roboto, Arial, sans-serif; font-size: 15px; }',
            language: 'fr_FR',
            language_url: 'https://cdn.jsdelivr.net/npm/tinymce-i18n@24/langs7/fr_FR.js',
            branding: false,
            promotion: false
        });
    </script>
{% endblock %}