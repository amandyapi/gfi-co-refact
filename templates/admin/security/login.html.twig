<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Connexion - Administration GFI-CO</title>
    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body { background: #1e2a3a; display: flex; align-items: center; justify-content: center; min-height: 100vh; font-family: 'Roboto', sans-serif; }
        .login-card { background: #fff; padding: 40px; border-radius: 10px; width: 100%; max-width: 420px; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
        .login-card h1 { font-size: 1.5rem; margin-bottom: 25px; text-align: center; color: #1e2a3a; }
        .login-card label { display: block; margin-bottom: 5px; font-size: 0.9rem; }
        .login-card input { width: 100%; padding: 10px; border: 1px solid #dde3ea; border-radius: 6px; margin-bottom: 15px; }
        .login-card button { width: 100%; background: #f68b1e; color: #fff; border: none; padding: 12px; border-radius: 6px; font-weight: 600; cursor: pointer; }
        .login-error { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <h1><i class="fa-solid fa-lock"></i> Administration</h1>

        {% if error %}
            <div class="login-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>
    </div>
</body>
</html>