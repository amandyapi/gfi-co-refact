{% extends 'layout-admin.html.twig' %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvel' }} utilisateur - Administration GFI-CO{% endblock %}
{% block page_title %}{{ isEdit ? 'Modifier un utilisateur' : 'Créer un utilisateur' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
        .form-control { width: 100%; padding: 10px 12px; border: 1px solid #dde3ea; border-radius: 6px; font-size: 0.95rem; }
        .form-control:focus { outline: none; border-color: #f68b1e; box-shadow: 0 0 0 3px rgba(246,139,30,.15); }
        .form-error { color: #b71c1c; font-size: 0.85rem; margin-top: 4px; }
        .form-row { display: flex; gap: 20px; }
        .form-row > * { flex: 1; }
        .role-check { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
        .switch { display: flex; align-items: center; gap: 8px; }
    </style>
{% endblock %}

{% block body %}
    <div class="admin-card" style="max-width:700px;">
        <form method="post">
            <div class="form-row">
                <div class="form-group">
                    <label for="firstname">Prénom *</label>
                    <input type="text" id="firstname" name="firstname" class="form-control" value="{{ data.firstname }}" required>
                    {% if errors.firstname is defined %}<div class="form-error">{{ errors.firstname }}</div>{% endif %}
                </div>
                <div class="form-group">
                    <label for="lastname">Nom *</label>
                    <input type="text" id="lastname" name="lastname" class="form-control" value="{{ data.lastname }}" required>
                    {% if errors.lastname is defined %}<div class="form-error">{{ errors.lastname }}</div>{% endif %}
                </div>
            </div>

            <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" class="form-control" value="{{ data.email }}" required>
                {% if errors.email is defined %}<div class="form-error">{{ errors.email }}</div>{% endif %}
            </div>

            <div class="form-group">
                <label>Rôles *</label>
                <div class="role-check">
                    <input type="checkbox" id="role_admin" name="roles[]" value="ROLE_ADMIN"
                           {{ 'ROLE_ADMIN' in data.roles ? 'checked' : '' }}>
                    <label for="role_admin" style="font-weight:400; margin:0;">Administrateur</label>
                </div>
                <div class="role-check">
                    <input type="checkbox" id="role_user" name="roles[]" value="ROLE_USER"
                           {{ 'ROLE_USER' in data.roles ? 'checked' : '' }}>
                    <label for="role_user" style="font-weight:400; margin:0;">Utilisateur</label>
                </div>
                {% if errors.roles is defined %}<div class="form-error">{{ errors.roles }}</div>{% endif %}
            </div>

            <div class="form-group">
                <label for="plainPassword">
                    {{ isEdit ? 'Nouveau mot de passe (laisser vide pour ne pas changer)' : 'Mot de passe *' }}
                </label>
                <input type="password" id="plainPassword" name="plainPassword" class="form-control"
                       {{ isEdit ? '' : 'required' }} minlength="6">
                {% if errors.plainPassword is defined %}<div class="form-error">{{ errors.plainPassword }}</div>{% endif %}
            </div>

            <div class="form-group">
                <div class="switch">
                    <input type="checkbox" id="isActive" name="isActive" value="1"
                           {{ data.isActive ? 'checked' : '' }}>
                    <label for="isActive" style="font-weight:400; margin:0;">Compte actif</label>
                </div>
            </div>

            <div style="margin-top:20px; display:flex; gap:10px;">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_admin_user_index') }}" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
{% endblock %}