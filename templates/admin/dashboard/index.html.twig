{% extends 'layout-admin.html.twig' %}

{% block title %}Tableau de bord - Administration GFI-CO{% endblock %}
{% block page_title %}Vue d'ensemble{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
        .kpi-card { background: #fff; border-radius: 8px; padding: 18px; box-shadow: 0 1px 4px rgba(0,0,0,.06); display: flex; flex-direction: column; gap: 6px; }
        .kpi-label { font-size: 0.8rem; color: #7f8c9b; text-transform: uppercase; letter-spacing: .5px; }
        .kpi-value { font-size: 2rem; font-weight: 700; color: #1e2a3a; line-height: 1; }
        .kpi-sub { font-size: 0.82rem; color: #95a5a6; }

        .dash-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 20px; }
        .dash-grid-3 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

        .admin-card h3 { font-size: 1rem; font-weight: 600; margin: 0 0 15px 0; color: #1e2a3a; }

        .mini-list { list-style: none; padding: 0; margin: 0; }
        .mini-list li { padding: 10px 0; border-bottom: 1px solid #eef1f5; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; }
        .mini-list li:last-child { border-bottom: none; }
        .mini-list .meta { color: #95a5a6; font-size: 0.8rem; }

        .badge-locale { display: inline-block; padding: 2px 7px; border-radius: 10px; font-size: 0.7rem; font-weight: 600; }
        .badge-fr { background: #e8f4fd; color: #1a73e8; }
        .badge-en { background: #fdf0e0; color: #d97706; }

        .quick-actions { display: flex; flex-direction: column; gap: 10px; }
        .quick-actions a { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #f8fafc; border-radius: 6px; text-decoration: none; color: #2c3e50; font-size: 0.9rem; transition: background .15s; }
        .quick-actions a:hover { background: #eef1f5; }
        .quick-actions a i { color: #f68b1e; width: 16px; text-align: center; }

        .category-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eef1f5; font-size: 0.9rem; }
        .category-row:last-child { border-bottom: none; }
        .category-count { background: #f1f3f6; color: #2c3e50; padding: 2px 9px; border-radius: 10px; font-size: 0.78rem; font-weight: 600; }

        .sys-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 0.88rem; border-bottom: 1px solid #eef1f5; }
        .sys-row:last-child { border-bottom: none; }
        .sys-row span:first-child { color: #7f8c9b; }
        .sys-row span:last-child { color: #1e2a3a; font-weight: 500; }
    </style>
{% endblock %}

{% block body %}

    {# ========== LIGNE 1 : KPI ========== #}
    <div class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Articles de blog</span>
            <span class="kpi-value">{{ totalPosts }}</span>
            <span class="kpi-sub">{{ postsFr }} FR · {{ postsEn }} EN</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Publiés ce mois</span>
            <span class="kpi-value">{{ publishedThisMonth }}</span>
            <span class="kpi-sub">
                {% if scheduledPosts > 0 %}
                    {{ scheduledPosts }} programmé{{ scheduledPosts > 1 ? 's' : '' }}
                {% else %}
                    Aucun programmé
                {% endif %}
            </span>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="kpi-card">
                <span class="kpi-label">Utilisateurs</span>
                <span class="kpi-value">{{ totalUsers }}</span>
                <span class="kpi-sub">{{ totalAdmins }} admin{{ totalAdmins > 1 ? 's' : '' }}</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Comptes inactifs</span>
                <span class="kpi-value">{{ inactiveUsers }}</span>
                <span class="kpi-sub">À surveiller</span>
            </div>
        {% else %}
            <div class="kpi-card">
                <span class="kpi-label">Catégories</span>
                <span class="kpi-value">{{ topCategories|length }}</span>
                <span class="kpi-sub">Actives</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Espace uploads</span>
                <span class="kpi-value">{{ (uploadsSize / 1024 / 1024)|number_format(1, ',', ' ') }}<small style="font-size:1rem;"> Mo</small></span>
                <span class="kpi-sub">Images blog</span>
            </div>
        {% endif %}
    </div>

    {# ========== LIGNE 2 : Derniers articles + Actions rapides ========== #}
    <div class="dash-grid">
        <div class="admin-card">
            <h3><i class="fa-solid fa-newspaper" style="color:#f68b1e;"></i> Derniers articles</h3>
            {% if latestPosts is empty %}
                <p style="color:#95a5a6; font-size:0.9rem;">Aucun article pour le moment.</p>
            {% else %}
                <ul class="mini-list">
                    {% for post in latestPosts %}
                        <li>
                            <div>
                                <a href="{{ path('app_admin_blog_edit', {id: post.id}) }}" style="text-decoration:none; color:#1e2a3a; font-weight:500;">
                                    {{ post.title|length > 55 ? post.title|slice(0, 55) ~ '…' : post.title }}
                                </a>
                                <div class="meta">
                                    {{ post.category|default('Sans catégorie') }}
                                    · {{ post.createdAt ? post.createdAt|date('d/m/Y') : '—' }}
                                </div>
                            </div>
                            <span class="badge-locale {{ post.locale == 'en' ? 'badge-en' : 'badge-fr' }}">
                                {{ post.locale|upper }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="admin-card">
            <h3><i class="fa-solid fa-bolt" style="color:#f68b1e;"></i> Actions rapides</h3>
            <div class="quick-actions">
                <a href="{{ path('app_admin_blog_new') }}">
                    <i class="fa-solid fa-plus"></i> Nouvel article
                </a>
                <a href="{{ path('app_admin_blog_index') }}">
                    <i class="fa-solid fa-list"></i> Tous les articles
                </a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_admin_user_new') }}">
                        <i class="fa-solid fa-user-plus"></i> Nouvel utilisateur
                    </a>
                    <a href="{{ path('app_admin_user_index') }}">
                        <i class="fa-solid fa-users"></i> Tous les utilisateurs
                    </a>
                {% endif %}
                <a href="{{ path('app_home', {_locale: 'fr'}) }}" target="_blank">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Voir le site
                </a>
            </div>
        </div>
    </div>

    {# ========== LIGNE 3 : Répartition + Catégories + Système ========== #}
    <div class="dash-grid-3">
        <div class="admin-card">
            <h3><i class="fa-solid fa-chart-simple" style="color:#f68b1e;"></i> Répartition par langue</h3>
            <div class="category-row">
                <span>🇫🇷 Français</span>
                <span class="category-count">{{ postsFr }}</span>
            </div>
            <div class="category-row">
                <span>🇬🇧 Anglais</span>
                <span class="category-count">{{ postsEn }}</span>
            </div>

            {% if topCategories|length > 0 %}
                <h3 style="margin-top:20px;"><i class="fa-solid fa-tags" style="color:#f68b1e;"></i> Top catégories</h3>
                {% for cat in topCategories %}
                    <div class="category-row">
                        <span>{{ cat.category }}</span>
                        <span class="category-count">{{ cat.total }}</span>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <div class="admin-card">
            <h3><i class="fa-solid fa-server" style="color:#f68b1e;"></i> Informations système</h3>
            <div class="sys-row">
                <span>Environnement</span>
                <span>
                    {% if environment == 'prod' %}
                        <span style="color:#1e7e34;">Production</span>
                    {% else %}
                        <span style="color:#d97706;">{{ environment|capitalize }}</span>
                    {% endif %}
                </span>
            </div>
            <div class="sys-row">
                <span>Version PHP</span>
                <span>{{ phpVersion }}</span>
            </div>
            <div class="sys-row">
                <span>Espace uploads</span>
                <span>{{ (uploadsSize / 1024 / 1024)|number_format(2, ',', ' ') }} Mo</span>
            </div>
            <div class="sys-row">
                <span>Symfony</span>
                <span>6.4</span>
            </div>
            <div class="sys-row">
                <span>Serveur</span>
                <span>{{ app.request.server.get('SERVER_SOFTWARE')|default('—')|slice(0, 30) }}</span>
            </div>
        </div>
    </div>

{% endblock %}